{
  "actions": [
    {
      "description": "Return supported AI coding agents and their local availability.",
      "effects": {
        "audit_required": false,
        "class": "read",
        "confirmation": "never",
        "reversible": true,
        "risk": "low"
      },
      "id": "agent.catalog",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "title": "List AI agents"
    },
    {
      "description": "Send annotations and an immutable source reference to an AI agent that writes a new output file.",
      "effects": {
        "audit_required": true,
        "class": "external",
        "confirmation": "conditional",
        "notes": "The agent writes a new output path; Redline never modifies the source.",
        "reversible": true,
        "risk": "medium"
      },
      "id": "agent.dispatch",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string"
          },
          "annotations": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "cwd": {
            "type": "string"
          },
          "dryRun": {
            "type": "boolean"
          },
          "expectedSourceSha256": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "timeoutSecs": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "agent",
          "source",
          "output"
        ],
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "title": "Dispatch AI agent"
    },

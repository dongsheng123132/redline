{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Redline 主窗口所需的最小权限集。文件读写全部经由后端 command，前端不直接拿文件系统权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-open-path"
  ]
}

{
  "name": "redline",
  "private": true,
  "version": "0.1.0",
  "description": "Redline —— 面向 AI 时代的万能文档预览标记层。打开任意文档/图片不需要装原软件，人在上面圈选标注，AI agent 据此去改真正的源文件。Redline 自己从不写回源文件。",
  "license": "Apache-2.0",
  "scripts": {
    "build": "cargo build --release",
    "test": "cargo test --workspace",
    "check:formats": "node scripts/check-format-parity.mjs",
    "check:shadowdoc": "node --test scripts/shadowdoc-validate.test.mjs",
    "check:shadowdoc-pk": "node --test scripts/shadowdoc-pk.test.mjs",
    "action-parity:generate": "node scripts/generate-action-parity.mjs",
    "action-parity:check": "node scripts/generate-action-parity.mjs --check",
    "action-parity:verify": "action-parity verify apps/redline-desktop/src/generated/action-parity.json --plan action-parity.verify.json --out artifacts/action-parity/action-parity.evidence.json --json",
    "benchmark:shadowdoc": "cargo run --release -p redline-core --example shadowdoc_benchmark",
    "benchmark:shadowdoc:corpus": "cargo run --release -p redline-core --example shadowdoc_benchmark -- --corpus-dir target/shadowdoc-pk-corpus",
    "benchmark:shadowdoc:pk": "node scripts/shadowdoc-pk.mjs spec/shadowdoc/benchmark/controlled.manifest.json",
    "desktop:dev": "pnpm --filter redline-desktop tauri dev",
    "desktop:build": "pnpm --filter redline-desktop tauri build",
    "check:core": "node scripts/check-core-purity.mjs",
    "check": "node scripts/check-format-parity.mjs && node scripts/check-core-purity.mjs && node scripts/generate-action-parity.mjs --check && node --test scripts/shadowdoc-validate.test.mjs scripts/shadowdoc-pk.test.mjs && cargo test --workspace && pnpm run action-parity:verify"
  },
  "devDependencies": {
    "action-parity": "github:dongsheng123132/action-parity#956df3bf210388a2398b0705e0ea3e10ffead394"
  }
}
